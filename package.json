{
  "name": "check-happens",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "npm run build && playwright test",
    "analyze:match": "node scripts/analyze-match.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "build:server": "tsc --noEmit && vite build --ssr server/index.ts --outDir dist-server",
    "start:server": "node dist-server/index.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "UNLICENSED"
}
